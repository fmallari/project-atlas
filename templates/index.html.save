<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Francis Mallari | Cloud Engineer / SRE</title>

  <link
    rel="stylesheet"
    href="{{ url_for('static', filename='css/portfolio.css') }}"
  >
</head>

<body>

  <!-- =======================================================
       NAVIGATION
       ======================================================= -->

  <header>
    <nav class="container">

      <a class="logo" href="/">
        FM<span>.</span>
      </a>

      <div class="nav-links">
        <a href="#atlas">Project Atlas</a>
        <a href="#about">About</a>
        <a href="https://github.com/fmallari">GitHub</a>
        <a href="https://www.linkedin.com/in/fmallari/">LinkedIn</a>
      </div>

    </nav>
  </header>


  <main>

    <!-- =====================================================
         HERO
         ===================================================== -->

    <div class="container hero">

      <div>

        <p class="eyebrow">
          Cloud Engineer / Site Reliability Engineer
        </p>

        <h1>
          Building reliable
          <em>cloud infrastructure.</em>
        </h1>

        <p class="lede">
          I build and operate production-style cloud systems with a focus
          on reliability, observability, automation, and operational excellence.
        </p>

        <div class="actions">

          <a
            class="btn primary"
            href="https://github.com/fmallari/project-atlas"
          >
            Explore Project Atlas ↗
          </a>

          <a class="btn" href="#about">
            About me
          </a>

        </div>

      </div>


      <aside class="status">

        <small>Currently building</small>

        <div>
          <h2>Project Atlas</h2>

          <p>
            Hands-on AWS infrastructure, observability,
            automation, and incident response.
          </p>
        </div>

      </aside>

    </div>


    <!-- =====================================================
         TECHNOLOGY STRIP
         ===================================================== -->

    <div class="strip">

      <div class="container">
        <span>AWS</span>
        <span>Terraform</span>
        <span>Linux</span>
        <span>Python</span>
        <span>Nginx</span>
        <span>CloudWatch</span>
        <span>IAM</span>
        <span>DNS / HTTPS</span>
      </div>

    </div>


    <!-- =====================================================
         PROJECT ATLAS
         ===================================================== -->

    <section id="atlas">

      <div class="container grid">

        <div class="section-title">
          Featured project
        </div>

        <div class="content">

          <h2>Project Atlas</h2>

          <p>
            Project Atlas is my hands-on Cloud Engineering and SRE
            environment built on AWS. I use it to practice the full
            engineering lifecycle — provisioning infrastructure, deploying
            applications, monitoring systems, troubleshooting incidents,
            automating repeatable work, and documenting operational decisions.
          </p>


          <div class="meta">

            <div>
              <small>Infrastructure</small>
              <strong>AWS + Terraform</strong>
            </div>

            <div>
              <small>Operations</small>
              <strong>Linux + Nginx + Gunicorn</strong>
            </div>

            <div>
              <small>Observability</small>
              <strong>CloudWatch + Health Checks</strong>
            </div>

          </div>


          <a href="https://github.com/fmallari/project-atlas">
            View the engineering repository ↗
          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         ABOUT
         ===================================================== -->

    <section id="about">

      <div class="container grid">

        <div class="section-title">
          About
        </div>

        <div class="content">

          <h2>
            Software engineering meets cloud operations.
          </h2>

          <p>
            My background spans software engineering, technical operations,
            and customer-focused problem solving. I enjoy understanding how
            systems work, solving the problems that make them unreliable,
            and automating the work that shouldn’t have to be done twice.
          </p>

          <p>
            I’m focused on Cloud Engineer, Platform Engineer, and SRE
            opportunities where I can help build reliable infrastructure,
            solve meaningful problems, and continue growing alongside
            experienced engineers.
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CONNECT
         ===================================================== -->

    <section>

      <div class="container grid">

        <div class="section-title">
          Connect
        </div>

        <div class="content">

          <h2>
            Let’s build reliable systems.
          </h2>

          <p>
            <a href="https://github.com/fmallari">GitHub ↗</a>
            &nbsp;
            <a href="https://www.linkedin.com/in/fmallari/">LinkedIn ↗</a>
            &nbsp;
            <a href="https://github.com/fmallari/project-atlas">Project Atlas ↗</a>

          </p>

        </div>

      </div>

    </section>

  </main>


  <!-- =======================================================
       FOOTER
       ======================================================= -->

  <footer>

    <div class="container footer">

      <span>Francis Mallari</span>

      <span>
        Cloud Engineering · Reliability · Automation
      </span>

    </div>

  </footer>

</body>

